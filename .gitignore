# Gemfile.lock is generated by Bundler and should not be committed
Gemfile.lock

# Jekyll generated files
_site/

# Log files
*.log

# Temporary files
*.swp
*.swo

# Operating system files
.DS_Store   # macOS specific
Thumbs.db   # Windows specific

# Bundler config
.bundle/

# Coverage directory used by test frameworks
coverage/

# IDE and editor files
.vscode/
.idea/

# Node.js dependencies (if using Node.js in your Jekyll site)
node_modules/

# RubyMine IDE files
.ruby-mine/

# Temporary files for development tools
jekyll-cache/

